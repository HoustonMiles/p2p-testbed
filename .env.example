# Copy to .env and edit, or set these inline before `docker compose up`.
# Every value here is the default used when the variable is unset.
# Per-peer settings exist for every peer (NAT_C_TYPE, CGN_AA_TYPE, ...);
# the committed docker-compose.yml has peers a and b (see docs/testbed.md).

# NAT behaviour of each home router:
#   full_cone | restricted | port_restricted | symmetric
NAT_A_TYPE=port_restricted
NAT_B_TYPE=port_restricted

# Is each home router on the public internet (wan) or behind CGNAT (cgnat)?
NAT_A_UPSTREAM=wan
NAT_B_UPSTREAM=wan

# NAT behaviour of each ISP's CGN (only used when that side is behind cgnat).
CGN_A_TYPE=port_restricted
CGN_B_TYPE=port_restricted

# Distance profile applied at every home router:
#   none | local (10 ms RTT) | coast (70 ms) | transatlantic (150 ms) | custom
# For custom, also set ONE_WAY_DELAY / ONE_WAY_JITTER / ONE_WAY_LOSS
# in the routers' environment (link_env in p2prunner/compose.py), e.g. 20ms / 3ms / 0.1%.
NET_PROFILE=local

# Access link capacity in Mbit/s. Leave empty for no cap.
# Set DOWNLINK_MBIT for any flood experiment, or floods can never fill the line.
UPLINK_MBIT=
DOWNLINK_MBIT=

# One peer's own access link, overriding the three settings above for it.
NET_PROFILE_A=
UPLINK_MBIT_A=
DOWNLINK_MBIT_A=
NET_PROFILE_B=
UPLINK_MBIT_B=
DOWNLINK_MBIT_B=

# Idle timeout (seconds) for UDP NAT mappings, i.e. how long pinholes live.
UDP_TIMEOUT=30
UDP_TIMEOUT_STREAM=120

# One-way delay (ms) the TURN relay adds to what it sends: a relay out of
# the way. A relayed round trip gets 2 x this more than the direct path.
RELAY_DELAY_MS=0

# Set to 1 to print each router's full iptables rules at startup.
DEBUG=0
